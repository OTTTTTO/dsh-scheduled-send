{
  "name": "@ottttto/dsh-scheduled-send",
  "version": "0.3.1",
  "description": "DSH plugin: scheduled sending (⏰ composer button, dock list of pending tasks, sidebar 定时任务 panel with cross-session cancel, due-time delivery as a normal user bubble)",
  "type": "module",
  "main": "./src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "cordis.patch.yml",
    "package.json",
    "README.md",
    "dsh.plugin.json"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/OTTTTTO/dsh-scheduled-send"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "scheduled",
    "timer",
    "定时发送"
  ],
  "author": "ottttto",
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ],
      "external": []
    }
  },
  "scripts": {
    "build": "npm run build:client",
    "build:client": "node scripts/build-client.mjs",
    "test": "node --test \"test/*.test.js\""
  },
  "engines": {
    "node": ">=18"
  }
}
